test "BT1 2AG on the Irish Grid" {
    var position: EastingNorthing = EastingNorthing {
        easting: 333890.0
        northing: 374638.0
        crs: "EPSG:29902"
    }
    var etrs89: Etrs89Position = attempt convert.to_etrs89(position)
    assert decimal.abs(etrs89.latitude - 54.60222639) < 0.000003
    assert decimal.abs(etrs89.longitude - -5.92889303) < 0.000003
    var wgs84: Point = attempt convert.to_wgs84(position)
    assert wgs84.latitude == etrs89.latitude
    assert wgs84.longitude == etrs89.longitude
    assert convert.to_osgb36(position) fails UnsupportedGrid
}

