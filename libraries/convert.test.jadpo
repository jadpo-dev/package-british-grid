// ospoint's test vectors, from its tests/data/national_grid.json and
// tests/data/irish_national_grid.json (MIT, Ideal Postcodes), each at its
// postcode. ospoint checks them to a relative 10⁻⁵, about 100 metres; these
// hold them to what the method gives: OSGB36 to 10⁻⁹ degrees, the vectors'
// own places; ETRS89 and WGS84 on the British grid to 10⁻⁸ degrees, about a
// millimetre; and on the Irish Grid, through TM65's Helmert, to 3 × 10⁻⁶
// degrees, about 30 centimetres.

test "NW1 9HZ on the British National Grid" {
    var position: EastingNorthing = EastingNorthing {
        easting: 529404.0
        northing: 184524.0
        crs: "EPSG:27700"
    }
    var osgb36: Osgb36Position = attempt convert.to_osgb36(position)
    assert decimal.abs(osgb36.latitude - 51.5442771915) < 0.000000001
    assert decimal.abs(osgb36.longitude - -0.1336688927) < 0.000000001
    var etrs89: Etrs89Position = attempt convert.to_etrs89(position)
    assert decimal.abs(etrs89.latitude - 51.544783154944) < 0.00000001
    assert decimal.abs(etrs89.longitude - -0.135276077351) < 0.00000001
    var wgs84: Point = attempt convert.to_wgs84(position)
    assert wgs84.latitude == etrs89.latitude
    assert wgs84.longitude == etrs89.longitude
}

