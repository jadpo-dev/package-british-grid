// Generated by Jadpo from this package's code; update it with `jadpo package check`, never by hand.
record surface 1

package BritishGrid.v1
    /// Grid references to latitude and longitude: British National Grid eastings and northings to OSGB36, ETRS89 and WGS84, and Irish Grid ones to ETRS89 and WGS84, by ospoint's method (MIT, Ideal Postcodes): good to a few metres, not survey grade.
    file package.jadpo
    kind library
    version 1.0.0
    publisher @jadpo
    licence apache_2_0
    jadpo 0.4
    guide GUIDE.md

function convert.to_etrs89
    /// A British National Grid or Irish Grid position as latitude and longitude on ETRS89, through ospoint's Helmert transformation: typically within a few metres, not survey grade.
    file libraries/convert.jadpo
    signature (position: EastingNorthing) -> Etrs89Position
    fails OutsideGrid
    fails UnsupportedGrid

function convert.to_osgb36
    /// A British National Grid position as latitude and longitude on OSGB36, the grid's own datum: Ordnance Survey's projection equations alone, with no change of datum, so good to well under a millimetre.
    file libraries/convert.jadpo
    signature (position: EastingNorthing) -> Osgb36Position
    fails OutsideGrid
    fails UnsupportedGrid

function convert.to_wgs84
    /// A British National Grid or Irish Grid position as a WGS84 `Point`. As ospoint does, it gives the ETRS89 coordinates: the two datums drift apart by about 2.5 cm a year, which is below this method's accuracy.
    file libraries/convert.jadpo
    signature (position: EastingNorthing) -> Point
    fails OutsideGrid
    fails UnsupportedGrid

type Etrs89Position = Object
    /// A latitude and a longitude in decimal degrees on ETRS89, the datum fixed to Europe that GPS positions in Britain are surveyed in. It drifts from WGS84 by about 2.5 cm a year, which is why it is kept apart from `Point`.
    file types/etrs89_position.jadpo
    latitude: Latitude
    longitude: Longitude

type Osgb36Position = Object
    /// A latitude and a longitude in decimal degrees on OSGB36, the datum of the British National Grid, on the Airy 1830 ellipsoid. OSGB36 lies around 100 metres from WGS84, so this is never a `Point`.
    file types/osgb36_position.jadpo
    latitude: Latitude
    longitude: Longitude

failure OutsideGrid
    /// The easting or the northing is outside its grid: below 0, or past 700,000 east or 1,300,000 north on the British National Grid and 400,000 east or 500,000 north on the Irish Grid.
    file failures/outside_grid.jadpo
    kind invalid_value
    code outside_grid
    message "That easting or northing is outside its grid."

failure UnsupportedGrid
    /// The position's `Crs` isn't a grid the conversion knows: the British National Grid, `EPSG:27700`, or for ETRS89 and WGS84 also the Irish Grid, `EPSG:29902`.
    file failures/unsupported_grid.jadpo
    kind invalid_value
    code unsupported_grid
    message "That coordinate reference system isn't one this conversion knows."
